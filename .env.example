# Arc Money Glitch ($AMG)
# Copy to .env.local. Never commit secrets.

# --- Token (defaults to live $AMG; override only if you redeploy) ---
AMG_TOKEN_ADDRESS=0x63c9A280E2756e5F190bf03d639c74b57bcDF85c
VITE_AMG_TOKEN_ADDRESS=0x63c9A280E2756e5F190bf03d639c74b57bcDF85c

# Optional override. Default: https://arcfun.co  (or /token/<address> once set)
# VITE_AMG_BUY_URL=https://arcfun.co

# --- Arc RPC ---
# Public baracat is the default. Infura (Arc enabled) is more reliable under load.
# ARC_RPC=https://arc-mainnet.infura.io/v3/<PROJECT_ID>
# VITE_ARC_RPC=https://arc-mainnet.infura.io/v3/<PROJECT_ID>
# VITE_INFURA_API_KEY=

# Optional extra fallbacks, comma-separated
# VITE_ARC_RPC_FALLBACKS=https://arc-mainnet-rpc.baracat.meme

# --- Site ---
# VITE_PUBLIC_HOSTNAME=amg.example.com

# --- Database (optional). Unset = embedded PGLite. ---
# DATABASE_URL=postgres://...

# Auth is unused for rewards (wallet-based). Leave off unless you want /login.
# VITE_AUTH_ENABLED=false
